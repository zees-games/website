---
import { Asset } from '../lib/asset'
import UmamiAnalytics from '../components/UmamiAnalytics.astro'
import '../styles/global.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { GITHUB_ORG, SITE_URL } from '../lib/site'
import { Graph, type JsonLd } from '../lib/seo'
import { LANG_TAG, LOCALES, LocalizePath, OG_LOCALE, StripLocale, type Locale } from '../i18n/config'

interface Props {
  locale: Locale
  title: string
  description: string
  /** Root-relative path of a 1200×630 JPEG Open Graph image (`npm run brand` makes them). */
  image?: string
  /** Alt text of `image`, in the page's language. */
  imageAlt: string
  /** Leave out canonical and hreflang (the 404 page, which has no address of its own). */
  noAlternates?: boolean
  /** Keep the page out of search results. */
  noindex?: boolean
  /** schema.org nodes for the page, rendered as one JSON-LD graph. */
  jsonLd?: JsonLd[]
}

const { locale, title, description: fullDescription, image = '/og/site.jpg', imageAlt, noAlternates = false, noindex = false, jsonLd = [] } = Astro.props
// Search results cut a description near 160 characters: end long ones at a word instead.
const description = fullDescription.length <= 160 ? fullDescription : `${fullDescription.slice(0, 157).replace(/\s+\S*$/, '')}…`
const fullTitle = title.includes("Zee's Games") ? title : `${title} · Zee's Games`
const canonical = new URL(Astro.url.pathname, SITE_URL).href
const ogImage = new URL(Asset(image), SITE_URL).href
const base = StripLocale(Astro.url.pathname)
---

<!doctype html>
<html lang={LANG_TAG[locale]} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noAlternates && <link rel="canonical" href={canonical} />}
    {!noAlternates && LOCALES.map((l) => <link rel="alternate" hreflang={LANG_TAG[l]} href={new URL(LocalizePath(base, l), SITE_URL).href} />)}
    {!noAlternates && <link rel="alternate" hreflang="x-default" href={new URL(base, SITE_URL).href} />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#05060f" />
    <meta name="color-scheme" content="dark" />
    <link rel="me" href={GITHUB_ORG} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zee's Games" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {!noAlternates && LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noAlternates && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLd.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(Graph(jsonLd)).replace(/</g, '\\u003c')} />}
    <UmamiAnalytics />
  </head>
  <body class="min-h-dvh flex flex-col">
    <Header locale={locale} />
    <main class="flex-1 overflow-x-clip">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
