---
import { DISCORD_URL, GITHUB_ORG, SITE_REPO, TmcHref } from '../lib/site'
import type { Locale } from '../i18n/config'
import { Escape, Rich, UseI18n } from '../i18n'
import { Ev } from '../lib/umami'
import Socials from './Socials.astro'

interface Props { locale: Locale }
const { locale } = Astro.props
const { t, p } = UseI18n(locale)
const tmcLink = `<a href="${TmcHref('/', locale)}" class="text-text underline decoration-cyan/50 underline-offset-4 hover:decoration-cyan">${Escape(t.footer.tmc)}</a>`
---

<footer class="mt-24 border-t border-line/70 bg-night">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-8 px-4 py-12 sm:px-6 md:grid-cols-[2fr_1fr_1fr]">
    <div class="col-span-2 max-w-md md:col-span-1">
      <p class="font-display text-lg font-bold"><span class="neon-cyan">Zee's</span> <span class="neon-amber">Games</span></p>
      <p class="mt-3 text-sm leading-relaxed text-muted" set:html={Rich(t.footer.blurb, { tmc: tmcLink })} />
      <div class="-ml-2 mt-4"><Socials locale={locale} place="footer" /></div>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">{t.footer.explore}</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={p('/#games')} class="hover:text-cyan">{t.nav.games}</a></li>
        <li><a href={p('/servers')} class="hover:text-cyan">{t.nav.servers}</a></li>
        <li><a href={p('/goals')} class="hover:text-cyan">{t.nav.goals}</a></li>
        <li><a href={p('/inspirations')} class="hover:text-cyan">{t.nav.inspirations}</a></li>
        <li><a href={TmcHref('/play', locale)} {...Ev('tmc_play', { place: 'footer' })} class="hover:text-cyan">{t.nav.playOnTmc}</a></li>
        <li><a href={DISCORD_URL} {...Ev('discord', { place: 'footer' })} class="hover:text-cyan">{t.footer.discord}</a></li>
      </ul>
    </div>
    <div>
      <p class="text-xs font-semibold uppercase tracking-widest text-muted">{t.footer.openSource}</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={GITHUB_ORG} {...Ev('repo_link', { kind: 'org', place: 'footer' })} class="hover:text-cyan">{t.footer.github}</a></li>
        <li><a href={SITE_REPO} {...Ev('repo_link', { kind: 'site', repo: 'website', place: 'footer' })} class="hover:text-cyan">{t.footer.sourceCode}</a></li>
        <li><a href="https://godotengine.org" class="hover:text-cyan">{t.footer.madeWithGodot}</a></li>
      </ul>
    </div>
  </div>
  <p class="border-t border-line/50 px-4 py-5 text-center text-xs text-muted">
    <a href={SITE_REPO} {...Ev('repo_link', { kind: 'site', repo: 'website', place: 'footer' })} class="font-semibold text-text hover:text-cyan">{t.footer.sourceOnGithub}</a> (MIT) ·
    {t.footer.disclaimer}
  </p>
</footer>
