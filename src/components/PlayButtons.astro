---
import { FaGithub } from 'react-icons/fa6'
import { Play, Server, ExternalLink } from 'lucide-react'
import type { Game } from '../data/games'
import { ACCENT } from '../lib/accent'
import { ServersFor } from '../data/servers'
import { TmcPlayHref, TmcGameHref, TmcServerPlayHref, RepoHref } from '../lib/site'
import type { Locale } from '../i18n/config'
import { Fmt, UseI18n } from '../i18n'
import { Ev } from '../lib/umami'

/*
 * Every way to play leaves this site for The Modding Community: Play Now is
 * TMC's quick play for the game, and Zee's server is that server's own play
 * address there. Nothing here launches a game itself.
 */
interface Props { game: Game; locale: Locale; /** Where the buttons sit, for analytics. */ place: 'game' | 'maps' }
const { game, locale, place } = Astro.props
const ev = { game: game.slug, place }
const { t } = UseI18n(locale)
const a = ACCENT[game.accent]
const server = ServersFor(game.slug)[0]
---

<div class="grid grid-cols-2 gap-3 sm:flex sm:flex-wrap">
  <a href={TmcPlayHref(game.slug, locale)} {...Ev('play_now', ev)} class:list={['col-span-2 inline-flex items-center justify-center gap-2 rounded-xl px-6 py-3 font-semibold transition hover:brightness-110', a.button]}>
    <Play className="size-5 fill-current" aria-hidden="true" /> {t.play.playNow}
  </a>
  {server && (
    <a href={TmcServerPlayHref(server, locale)} {...Ev('play_server', { ...ev, server: server.id })} class="col-span-2 inline-flex items-center justify-center gap-2 rounded-xl border border-line bg-panel px-5 py-3 font-semibold transition hover:border-emerald-400/60">
      <Server className="size-5 text-emerald-400" aria-hidden="true" /> {t.play.zeesServer}
    </a>
  )}
  <a href={TmcGameHref(game.slug, locale)} {...Ev('tmc_game', ev)} class="inline-flex items-center justify-center gap-2 rounded-xl border border-line bg-panel px-4 py-3 text-center text-sm leading-tight font-semibold transition hover:border-cyan/60 sm:px-5 sm:text-base">
    <ExternalLink className="size-5 shrink-0 text-muted" aria-hidden="true" /> {Fmt(t.play.onTmc, { title: game.title })}
  </a>
  <a href={RepoHref(game.repo)} {...Ev('repo_link', { kind: 'game', repo: game.repo, place })} class="inline-flex items-center justify-center gap-2 rounded-xl border border-line bg-panel px-4 py-3 text-center text-sm leading-tight font-semibold transition hover:border-cyan/60 sm:px-5 sm:text-base">
    <FaGithub className="size-5 shrink-0 text-muted" aria-hidden="true" /> {t.play.source}
  </a>
</div>
