---
import type { Game } from '../data/games'
import { HostOf } from '../lib/site'
import { MapIds, SiteMapsHref } from '../lib/redirects'
import { LANG_TAG, type Locale } from '../i18n/config'
import { Escape, Fmt, Rich, UseI18n } from '../i18n'

/*
 * The maps page of a game with its own site. Our nginx answers this address
 * with a 301 before the file is ever read (`src/lib/redirects.ts`); this page
 * is only for a host that serves `dist/` as plain files: noindex, a canonical
 * to the site's maps page, and an immediate redirect that keeps the fragment
 * (as nginx's 301 does): a `#<map id>` this site knows goes straight to that
 * map's page there, any other fragment rides along to `<site>/maps`, which
 * turns a `#<id>` into `/maps/<id>` itself. A meta refresh cannot carry the
 * fragment, so it only runs without script (in `noscript`, where it cannot
 * race the script's navigation to the fragment-less address).
 */
interface Props { game: Game & { site: string }; locale: Locale }
const { game, locale } = Astro.props
const { t } = UseI18n(locale)
const to = SiteMapsHref(game.site)
const host = HostOf(game.site)
const link = `<a href="${Escape(to)}">${Escape(host)}</a>`
---

<!doctype html>
<html lang={LANG_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{Fmt(t.meta.mapsTitle, { title: game.title })}</title>
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={to} />
    <script is:inline define:vars={{ to, ids: MapIds(game.slug) }}>
      var id = ''
      try { id = decodeURIComponent(location.hash.slice(1)) } catch (e) {}
      location.replace(id && ids.indexOf(id) >= 0 ? to + '/' + encodeURIComponent(id) : to + location.hash)
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${to}`} /></noscript>
  </head>
  <body>
    <p set:html={Rich(t.game.mapsMoved, { host: link }, { title: game.title })} />
  </body>
</html>
