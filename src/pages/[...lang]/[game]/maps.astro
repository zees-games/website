---
import { FaGithub } from 'react-icons/fa6'
import Layout from '../../../layouts/Layout.astro'
import PlayButtons from '../../../components/PlayButtons.astro'
import { GAMES, type Game } from '../../../data/games'
import { ACCENT } from '../../../lib/accent'
import { MapsFor, type MapEntry } from '../../../lib/maps'
import { RepoHref } from '../../../lib/site'
import { LANG_TAG, LocalePaths, type Locale } from '../../../i18n/config'
import { Escape, Fmt, Rich, UseI18n } from '../../../i18n'
import { Ev } from '../../../lib/umami'
import { BreadcrumbLd } from '../../../lib/seo'
import type { Messages } from '../../../i18n/ui/en'
import { Search, ImageOff, ExternalLink, Sparkles } from 'lucide-react'

export function getStaticPaths() {
  return LocalePaths().flatMap(({ params, props }) =>
    GAMES.filter((game) => MapsFor(game.slug)).map((game) => ({ params: { ...params, game: game.slug }, props: { ...props, game } })),
  )
}

interface Props { game: Game; locale: Locale }
const { game, locale } = Astro.props
const { t, p, plural } = UseI18n(locale)
const a = ACCENT[game.accent]
const pack = MapsFor(game.slug)!
const ported = pack.maps.filter((m) => m.originalMap).length

/** Map families by their name prefix (surf_, bhop_, ...), for the filter chips. */
type Family = keyof Messages['maps']['families']
const PREFIX: Record<string, Family> = { surf: 'surf', bhop: 'bhop', bunnyhop: 'bhop', kz: 'kz', ze: 'ze', zs: 'zs' }
const familyOf = (m: MapEntry): Family | null => PREFIX[m.id.split('_')[0]] ?? null
const families = [...new Set(pack.maps.map(familyOf).filter((f): f is Family => f !== null))]

const intro = ported === 0
  ? Fmt(t.maps.nonePorted, { title: game.title })
  : ported === pack.maps.length ? t.maps.allPorted : Fmt(t.maps.somePorted, { n: ported })

const mono = (s: string) => `<span class="font-mono text-text">${Escape(s)}</span>`
function credit(m: MapEntry): string {
  const base = m.originalMap
    ? Rich(m.originalGame ? t.maps.portedFromGame : t.maps.portedFrom, { map: mono(m.originalMap) }, { game: m.originalGame ?? '' })
    : Escape(Fmt(t.maps.madeFor, { title: game.title }))
  return m.author ? `${base} ${Escape(Fmt(t.maps.by, { author: m.author }))}` : base
}
---

<Layout
  locale={locale}
  title={Fmt(t.meta.mapsTitle, { title: game.title })}
  description={Fmt(ported ? t.meta.mapsDescription : t.meta.mapsDescriptionOwn, { title: game.title })}
  image={`/og/${game.slug}.jpg`}
  imageAlt={Fmt(t.meta.ogGameAlt, { title: game.title })}
  jsonLd={[BreadcrumbLd(locale, [[game.title, `/${game.slug}`], [Fmt(t.meta.mapsTitle, { title: game.title }), `/${game.slug}/maps`]])]}
>
  <section class="relative isolate overflow-hidden border-b border-line/60">
    <div class="pointer-events-none absolute -top-40 left-1/3 -z-10 size-[36rem] rounded-full bg-violet/15 blur-[110px]" aria-hidden="true"></div>
    <div class="mx-auto max-w-7xl px-4 pb-12 pt-16 sm:px-6">
      <a href={p(`/${game.slug}`)} class="text-sm text-muted hover:text-text">← {game.title}</a>
      <h1 class="mt-4 text-4xl font-bold sm:text-6xl" set:html={Rich(t.maps.heading, { title: Escape(game.title), maps: `<span class="${a.text}">${Escape(t.maps.headingWord)}</span>` })} />
      <p class="mt-4 max-w-3xl text-lg text-muted">{plural(t.maps.count, pack.maps.length)} {intro}</p>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <PlayButtons game={game} locale={locale} place="maps" />
      </div>
      <a href={RepoHref(pack.repo)} {...Ev('repo_link', { kind: 'maps', repo: pack.repo, game: game.slug, place: 'maps' })} class="mt-5 inline-flex items-center gap-2 rounded-lg border border-line bg-night/70 px-4 py-2 text-sm font-semibold transition hover:border-cyan/60">
        <FaGithub className="size-4" aria-hidden="true" /> {t.maps.mapPack}
        <span class="font-mono text-xs font-normal text-muted">zees-games/{pack.repo}</span>
      </a>
    </div>
  </section>

  <div class="mx-auto max-w-7xl px-4 pt-10 sm:px-6">
    <div class="sticky top-16 z-30 -mx-4 flex flex-wrap items-center gap-3 border-b border-line/50 bg-ink/85 px-4 py-3 backdrop-blur-xl sm:mx-0 sm:rounded-xl sm:border sm:px-4">
      <label class="flex min-w-0 flex-1 items-center gap-2 rounded-lg border border-line bg-night px-3 py-2 focus-within:border-cyan/60">
        <Search className="size-4 shrink-0 text-muted" aria-hidden="true" />
        <input id="map-search" type="search" placeholder={t.maps.search} class="w-full min-w-0 bg-transparent text-sm outline-none placeholder:text-muted" aria-label={t.maps.search} />
      </label>
      {families.length > 1 && (
        <div class="flex flex-wrap gap-2" role="group" aria-label={t.maps.filter}>
          <button type="button" data-family="" aria-pressed="true" class="family-chip rounded-lg border border-line px-3 py-1.5 text-sm aria-pressed:border-cyan/60 aria-pressed:bg-cyan/10 aria-pressed:text-cyan">{t.maps.all}</button>
          {families.map((f) => (
            <button type="button" data-family={f} aria-pressed="false" class="family-chip rounded-lg border border-line px-3 py-1.5 text-sm aria-pressed:border-cyan/60 aria-pressed:bg-cyan/10 aria-pressed:text-cyan">{t.maps.families[f]}</button>
          ))}
        </div>
      )}
      <span id="map-count" class="text-sm text-muted" data-lang={LANG_TAG[locale]} data-forms={JSON.stringify(t.maps.shown)}>{plural(t.maps.shown, pack.maps.length)}</span>
    </div>

    <ul class="mt-8 grid gap-6 lg:grid-cols-2" id="map-list" data-game={game.slug}>
      {pack.maps.map((m) => (
        <li id={m.id} data-name={`${m.name} ${m.id} ${m.originalMap ?? ''}`.toLowerCase()} data-family={familyOf(m) ?? ''} class="map-card glow-card scroll-mt-36 overflow-hidden">
          <div class:list={['grid gap-px bg-line', m.originalMap && 'grid-cols-2']}>
            <figure class="relative bg-night">
              {m.image ? (
                <img src={m.image} alt={Fmt(t.game.mapAlt, { map: m.name, title: game.title })} loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
              ) : (
                <div class="grid aspect-video place-items-center text-muted"><ImageOff className="size-8" aria-hidden="true" /><span class="sr-only">{t.maps.noScreenshot}</span></div>
              )}
              <figcaption class:list={['absolute left-2 top-2 rounded-md border px-2 py-0.5 text-[11px] font-semibold backdrop-blur', a.border, 'bg-ink/70', a.text]}>{t.maps.labelOurs}</figcaption>
            </figure>
            {m.originalMap && (
              <figure class="relative bg-night">
                {m.original ? (
                  <img src={m.original.image} alt={Fmt(t.maps.originalAlt, { map: m.originalMap, game: m.originalGame ?? t.maps.theOriginalGame })} loading="lazy" decoding="async" class="aspect-video w-full object-cover" />
                ) : (
                  <div class="grid aspect-video place-items-center text-center text-xs text-muted"><span><ImageOff className="mx-auto mb-1 size-7" aria-hidden="true" />{t.maps.noOriginal}</span></div>
                )}
                <figcaption class="absolute left-2 top-2 rounded-md border border-line bg-ink/70 px-2 py-0.5 text-[11px] font-semibold text-muted backdrop-blur">{t.maps.labelOriginal}</figcaption>
              </figure>
            )}
          </div>
          <div class="space-y-1.5 p-4">
            <h2 class="text-lg font-bold">{m.name}</h2>
            <p class="font-mono text-xs text-muted">{m.id}</p>
            {m.originalMap ? (
              <p class="text-sm text-muted" set:html={credit(m)} />
            ) : (
              <p class="flex items-center gap-1.5 text-sm text-muted"><Sparkles className={`size-4 shrink-0 ${a.text}`} aria-hidden="true" /><span set:html={credit(m)} /></p>
            )}
            {m.original?.source && (
              <p class="text-xs text-muted">
                {t.maps.originalShot} <a href={m.original.source} class="inline-flex items-center gap-1 underline decoration-line underline-offset-2 hover:text-text" rel="nofollow noopener">{m.original.sourceName ?? t.maps.source} <ExternalLink className="size-3" aria-hidden="true" /></a>
                {m.original.matched && <> {Fmt(t.maps.closestMatch, { map: m.original.matched })}</>}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
    <p id="map-empty" class="hidden py-16 text-center text-muted">{t.maps.none}</p>
  </div>
</Layout>

<script>
  import { QueryField, track } from '../../../lib/umami'

  const input = document.getElementById('map-search') as HTMLInputElement | null
  const cards = [...document.querySelectorAll<HTMLElement>('.map-card')]
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.family-chip')]
  const count = document.getElementById('map-count')
  const empty = document.getElementById('map-empty')
  // The count's plural forms ship with the page, in its language.
  const lang = count?.dataset.lang ?? 'en'
  const forms = JSON.parse(count?.dataset.forms ?? '{"other":"{n}"}') as Record<string, string>
  const rules = new Intl.PluralRules(lang)
  const num = new Intl.NumberFormat(lang)
  const game = document.getElementById('map-list')?.dataset.game
  let family = ''
  let searchTimer: ReturnType<typeof setTimeout> | undefined
  let lastQuery = ''

  function apply() {
    const q = (input?.value ?? '').trim().toLowerCase()
    let shown = 0
    for (const c of cards) {
      const ok = (!q || (c.dataset.name ?? '').includes(q)) && (!family || c.dataset.family === family)
      c.hidden = !ok
      if (ok) shown++
    }
    if (count) count.textContent = (forms[rules.select(shown)] ?? forms.other).replace('{n}', num.format(shown))
    empty?.classList.toggle('hidden', shown > 0)
    return shown
  }

  // Report a settled query, not every keystroke: "surf" would otherwise file s, su, sur.
  input?.addEventListener('input', () => {
    const shown = apply()
    clearTimeout(searchTimer)
    searchTimer = setTimeout(() => {
      const q = QueryField(input.value)
      if (!q || q === lastQuery) return
      lastQuery = q
      track('maps_search', { game, query: q, results: shown, family: family || undefined })
    }, 1000)
  })
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      family = chip.dataset.family ?? ''
      for (const c of chips) c.setAttribute('aria-pressed', String(c === chip))
      const shown = apply()
      track('maps_filter', { game, family: family || 'all', results: shown })
    })
  }
</script>
