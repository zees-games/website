---
import MapsList from '../../../components/MapsList.astro'
import MovedMaps from '../../../components/MovedMaps.astro'
import { GAMES, type Game } from '../../../data/games'
import { MapsFor } from '../../../lib/maps'
import { LocalePaths, type Locale } from '../../../i18n/config'

/*
 * A game's maps. A game with its own site keeps its maps there, so its page
 * here is only the fallback for the 301 nginx sends (MovedMaps); the rest get
 * the full list (MapsList).
 */
export function getStaticPaths() {
  return LocalePaths().flatMap(({ params, props }) =>
    GAMES.filter((game) => MapsFor(game.slug)).map((game) => ({ params: { ...params, game: game.slug }, props: { ...props, game } })),
  )
}

interface Props { game: Game; locale: Locale }
const { game, locale } = Astro.props
const site = game.site
---

{site ? <MovedMaps game={{ ...game, site }} locale={locale} /> : <MapsList game={game} locale={locale} />}
