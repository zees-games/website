---
import { Asset } from '../../../lib/asset'
import { FaDiscord, FaGithub } from 'react-icons/fa6'
import Layout from '../../../layouts/Layout.astro'
import PlayButtons from '../../../components/PlayButtons.astro'
import GameCard from '../../../components/GameCard.astro'
import Controls from '../../../components/Controls.astro'
import { GAMES, type Game } from '../../../data/games'
import { ACCENT } from '../../../lib/accent'
import { MapsFor } from '../../../lib/maps'
import { ServerPath, ServersFor } from '../../../data/servers'
import { DISCORD_URL, RepoHref, TMC_SURFACES, TmcGameHref, TmcServersHref, TmcSurfaceHref } from '../../../lib/site'
import { LocalePaths, type Locale } from '../../../i18n/config'
import { Fmt, UseI18n } from '../../../i18n'
import { Ev } from '../../../lib/umami'
import { BreadcrumbLd, GameLd } from '../../../lib/seo'
import { Gamepad2, Lightbulb, Map, ArrowRight, Bug, ExternalLink, History, ListChecks, Route, Server } from 'lucide-react'

export function getStaticPaths() {
  return LocalePaths().flatMap(({ params, props }) =>
    GAMES.map((game) => ({ params: { ...params, game: game.slug }, props: { ...props, game } })),
  )
}

interface Props { game: Game; locale: Locale }
const { game, locale } = Astro.props
const { t, g, p } = UseI18n(locale)
const text = g(game.slug)
const a = ACCENT[game.accent]
const maps = MapsFor(game.slug)
// The six shots that read best as thumbnails; alphabetical order put near-black ones first.
const preview = maps?.maps.filter((m) => m.image).sort((x, y) => (y.score ?? 0) - (x.score ?? 0)).slice(0, 6) ?? []
const others = GAMES.filter((o) => o.slug !== game.slug).slice(0, 4)
const cover = Asset(`/images/games/${game.slug}.webp`)
const mapsPath = p(`/${game.slug}/maps`)
const servers = ServersFor(game.slug)
const SURFACE_ICON = { roadmap: Route, changelog: History, bugs: Bug }
---

<Layout locale={locale} title={game.title} description={Fmt(t.meta.gameDescription, { title: game.title, tagline: text.tagline })} image={`/og/${game.slug}.jpg`} imageAlt={Fmt(t.meta.ogGameAlt, { title: game.title })} jsonLd={[GameLd(game, text, locale), BreadcrumbLd(locale, [[game.title, `/${game.slug}`]])]}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden border-b border-line/60">
    <img src={cover} width="1920" height="1080" alt="" class="absolute inset-0 -z-20 size-full object-cover opacity-45" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/85 to-ink/30"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-transparent to-transparent"></div>
    <div class="mx-auto max-w-7xl px-4 pb-16 pt-20 sm:px-6 sm:pt-28">
      <a href={p('/#games')} class="text-sm text-muted hover:text-text">{t.game.allGames}</a>
      <p class:list={['mt-6 inline-flex rounded-full border px-3 py-1 text-xs font-semibold uppercase tracking-widest', a.border, a.bg, a.text]}>{t.kind[game.kind]}</p>
      <h1 class="mt-4 text-5xl font-bold sm:text-7xl">{game.title}</h1>
      <p class="mt-4 max-w-2xl text-xl text-muted">{text.tagline}</p>
      <div class="mt-8"><PlayButtons game={game} locale={locale} place="game" /></div>
    </div>
  </section>

  <div class="mx-auto grid max-w-7xl gap-10 px-4 pt-14 sm:px-6 lg:grid-cols-[1fr_20rem]">
    <div class="min-w-0 space-y-12">
      <section>
        <h2 class="flex items-center gap-2 text-2xl font-bold"><Gamepad2 className={`size-6 ${a.text}`} /> {t.game.whatItIs}</h2>
        {text.summary.map((para) => <p class="mt-4 text-lg leading-relaxed text-muted">{para}</p>)}
      </section>

      <section>
        <h2 class="flex items-center gap-2 text-2xl font-bold"><ListChecks className={`size-6 ${a.text}`} /> {t.game.howToPlay}</h2>
        <ol class="mt-5 space-y-3">
          {text.howToPlay.map((step, i) => (
            <li class="flex gap-4 rounded-xl border border-line bg-panel/70 p-4">
              <span class:list={['grid size-8 shrink-0 place-items-center rounded-lg font-display font-bold', a.bg, a.text]}>{i + 1}</span>
              <span class="pt-1 text-muted">{step}</span>
            </li>
          ))}
        </ol>
      </section>

      <Controls slug={game.slug} locale={locale} accent={a.text} />

      {maps && (
        <section>
          <div class="flex flex-wrap items-end justify-between gap-3">
            <h2 class="flex items-center gap-2 text-2xl font-bold"><Map className={`size-6 ${a.text}`} /> {t.game.maps}</h2>
            <div class="flex flex-wrap items-center gap-4">
              <a href={RepoHref(maps.repo)} {...Ev('repo_link', { kind: 'maps', repo: maps.repo, game: game.slug, place: 'game' })} class="inline-flex items-center gap-1.5 text-sm font-semibold text-muted hover:text-text">
                <FaGithub className="size-4" aria-hidden="true" /> {t.game.mapPack}
              </a>
              <a href={mapsPath} class:list={['inline-flex items-center gap-1.5 text-sm font-semibold hover:underline', a.text]}>
                {Fmt(t.game.allMaps, { n: maps.maps.length })} <ArrowRight className="size-4" />
              </a>
            </div>
          </div>
          {preview.length > 0 && (
            <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3">
              {preview.map((m) => (
                <a href={`${mapsPath}#${m.id}`} {...Ev('map_preview', { game: game.slug, map: m.id })} class="group relative overflow-hidden rounded-xl border border-line">
                  <img src={m.image!} width="960" height="540" alt={Fmt(t.game.mapAlt, { map: m.name, title: game.title })} loading="lazy" class="aspect-video w-full object-cover transition duration-500 group-hover:scale-105" />
                  <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 to-transparent px-3 pb-2 pt-6 text-sm font-semibold">{m.name}</span>
                </a>
              ))}
            </div>
          )}
        </section>
      )}
    </div>

    <aside class="space-y-5 lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-line bg-panel/80 p-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">{t.game.modes}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {text.modes.map((m) => <li class="rounded-lg border border-line bg-night px-3 py-1.5 text-sm">{m}</li>)}
        </ul>
        {text.inspiredBy && (
          <>
            <p class="mt-5 flex items-center gap-1.5 text-xs font-semibold uppercase tracking-widest text-muted"><Lightbulb className="size-3.5" /> {t.game.inspiredBy}</p>
            <p class="mt-2 text-sm">{text.inspiredBy}</p>
          </>
        )}
      </div>
      <div class="rounded-2xl border border-line bg-panel/80 p-5">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted">{t.game.links}</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href={TmcGameHref(game.slug, locale)} {...Ev('tmc_game', { game: game.slug, place: 'sidebar' })} class="flex items-center gap-2 hover:text-cyan"><ExternalLink className="size-4 shrink-0 text-muted" /> {Fmt(t.game.onTmcLong, { title: game.title })}</a></li>
          {servers.map((s) => <li><a href={p(ServerPath(s))} {...Ev('server_card', { server: s.id, place: 'game' })} class="flex items-center gap-2 hover:text-cyan"><Server className="size-4 shrink-0 text-emerald-400" /> {s.name}</a></li>)}
          <li><a href={TmcServersHref(game.slug, locale)} {...Ev('tmc_servers', { game: game.slug })} class="flex items-center gap-2 hover:text-cyan"><ExternalLink className="size-4 shrink-0 text-muted" /> {t.game.serverBrowser}</a></li>
          {TMC_SURFACES.map((s) => {
            const Icon = SURFACE_ICON[s]
            return <li><a href={TmcSurfaceHref(game.slug, s, locale)} {...Ev('tmc_surface', { game: game.slug, surface: s })} class="flex items-center gap-2 hover:text-cyan"><Icon className="size-4 shrink-0 text-muted" /> {t.game[s]}</a></li>
          })}
          <li><a href={RepoHref(game.repo)} {...Ev('repo_link', { kind: 'game', repo: game.repo, place: 'sidebar' })} class="flex items-center gap-2 hover:text-cyan"><FaGithub className="size-4 shrink-0 text-muted" /> {game.repo}</a></li>
          {game.mapsRepo && <li><a href={RepoHref(game.mapsRepo)} {...Ev('repo_link', { kind: 'maps', repo: game.mapsRepo, game: game.slug, place: 'sidebar' })} class="flex items-center gap-2 hover:text-cyan"><FaGithub className="size-4 shrink-0 text-muted" /> {game.mapsRepo}</a></li>}
          <li><a href={DISCORD_URL} {...Ev('discord', { game: game.slug, place: 'game' })} class="flex items-center gap-2 hover:text-cyan"><FaDiscord className="size-4 shrink-0 text-muted" /> {t.footer.discord}</a></li>
        </ul>
      </div>
    </aside>
  </div>

  <section class="mx-auto mt-24 max-w-7xl px-4 sm:px-6">
    <h2 class="text-2xl font-bold">{t.game.moreGames}</h2>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {others.map((o) => <GameCard game={o} locale={locale} place="more" />)}
    </div>
  </section>
</Layout>
