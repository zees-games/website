# Rendered to /etc/nginx/conf.d/default.conf at container start; the image's
# entrypoint fills in the listen port and nothing else (NGINX_ENVSUBST_FILTER).
# The host's nginx terminates TLS in front of this.

# Game and maps pages that moved to a game's own site (prophunt.net,
# playlot.app, ...): old path -> absolute URL (the site's home page or its
# /maps), generated at build from the site's content
# (src/lib/redirects.ts -> dist-nginx/moved.map; never edit it by hand).
map $uri $zg_moved {
    default "";
    include /etc/nginx/moved.map;
}

server {
    listen ${INTERNAL_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Astro's directory output answers a bare path with a 301; keep it relative
    # so the client is not sent the container's own address.
    absolute_redirect off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # The Umami snippet, or nothing (written at start by 40-umami.sh).
    include /etc/nginx/umami.conf;

    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml application/manifest+json;

    # Hashed build chunks: the name changes with the contents.
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }

    # The share banners and icons are regenerated by `npm run brand` under the
    # same names, so they get the week's cache the images do, not immutable.
    location ~ ^/(images|og)/ {
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }

    location = /site.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    # Moved pages first, so a former slug's game or maps page goes straight to
    # the game's site instead of through the slug rewrite below (one hop, no chain).
    if ($zg_moved) {
        return 301 $zg_moved$is_args$args;
    }

    # Renamed games keep their old addresses: every page under the old slug, in
    # every locale, and the old cover, share-banner and map-shot names move
    # permanently to the new slug (the query string carries over).
    rewrite ^(/(?:es|fr|de|ru|nl|ja|zh|pt))?/(?:arena|fatalcontact)(/.*)?$ $1/fatal-contact$2 permanent;
    rewrite ^(/(?:es|fr|de|ru|nl|ja|zh|pt))?/g2gfast(/.*)?$ $1/airdrift$2 permanent;
    rewrite ^(/(?:es|fr|de|ru|nl|ja|zh|pt))?/playground(/.*)?$ $1/playlot$2 permanent;
    rewrite ^/(og|images/games)/arena\.(jpg|webp)$ /$1/fatal-contact.$2 permanent;
    rewrite ^/(og|images/games)/g2gfast\.(jpg|webp)$ /$1/airdrift.$2 permanent;
    rewrite ^/(og|images/games)/playground\.(jpg|webp)$ /$1/playlot.$2 permanent;
    rewrite ^/images/maps/arena/(.*)$ /images/maps/fatal-contact/$1 permanent;
    rewrite ^/images/maps/g2gfast/(.*)$ /images/maps/airdrift/$1 permanent;
    rewrite ^/images/maps/playground/(.*)$ /images/maps/playlot/$1 permanent;

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}
