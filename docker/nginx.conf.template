# Rendered to /etc/nginx/conf.d/default.conf at container start; the image's
# entrypoint fills in the listen port and nothing else (NGINX_ENVSUBST_FILTER).
# The host's nginx terminates TLS in front of this.
server {
    listen ${INTERNAL_PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Astro's directory output answers a bare path with a 301; keep it relative
    # so the client is not sent the container's own address.
    absolute_redirect off;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_proxied any;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;

    # Hashed build chunks: the name changes with the contents.
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }

    location /images/ {
        add_header Cache-Control "public, max-age=604800";
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        access_log off;
    }

    location / {
        try_files $uri $uri/ $uri.html =404;
    }

    error_page 404 /404.html;
}
